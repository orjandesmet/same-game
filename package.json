{
  "name": "same-game",
  "version": "1.2.1",
  "dependencies": {
    "@netlify/vite-plugin": "^2.11.2",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "bumped": "^0.14.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint-staged": "lint-staged",
    "pre-commit": "husky precommit",
    "prepare": "husky",
    "preview": "vite preview",
    "release:major": "bumped release major",
    "release:minor": "bumped release minor",
    "release:patch": "bumped release patch",
    "test": "vitest --watch",
    "test:check": "vitest",
    "test:ci": "vitest run --coverage"
  },
  "private": true,
  "lint-staged": {
    "*.{css,scss,html,json,cjs,mjs,js,ts,yaml,md,jsx,tsx}": "prettier --write",
    "*.{js,ts,jsx,tsx}": "eslint --fix",
    "*.{css,scss}": "stylelint --fix"
  },
  "type": "module"
}
